# Copy this file to .env for local runs. Never commit .env.

# Source-to-dialogue generation
OPENAI_API_KEY=replace_me
SCRIPT_MODEL=gpt-4.1-mini
RESEARCH_MODEL=gpt-5.4-mini
RESEARCH_ON_GAPS=true

# Optional cost overrides, in USD per 1M tokens/characters. Defaults cover the models above.
# GPT_4_1_MINI_INPUT_COST_PER_MILLION=0.40
# GPT_4_1_MINI_OUTPUT_COST_PER_MILLION=1.60
# GPT_5_4_MINI_INPUT_COST_PER_MILLION=0.75
# GPT_5_4_MINI_OUTPUT_COST_PER_MILLION=4.50
# GOOGLE_TTS_COST_PER_MILLION_CHARS=16
# ELEVENLABS_TTS_COST_PER_MILLION_CHARS=80

# Audio provider: use "local" for free macOS testing, "google" for Google Cloud TTS,
# or "elevenlabs" for hosted production voice quality.
TTS_PROVIDER=elevenlabs

# Two distinct ElevenLabs voices are required when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_VOICE_A=replace_me
ELEVENLABS_VOICE_B=replace_me
ELEVENLABS_MODEL=eleven_multilingual_v2

# Built-in macOS voices used when TTS_PROVIDER=local. Check names with: say -v '?'
LOCAL_VOICE_A=Samantha
LOCAL_VOICE_B=Alex

# Google Cloud TTS. Use two distinct voice names for speaker A and B.
GOOGLE_CLOUD_AUDIO_API_KEY=replace_me
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_VOICE_A=en-US-Neural2-F
GOOGLE_VOICE_B=en-US-Neural2-J

# Cloudflare R2 S3-compatible upload configuration
R2_ACCOUNT_ID=replace_me
R2_BUCKET=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_PUBLIC_BASE_URL=https://media.example.com
