# Copy this file to .env for local runs. Never commit .env.

# Source-to-dialogue generation
OPENAI_API_KEY=replace_me
SCRIPT_MODEL=gpt-4.1-mini
RESEARCH_MODEL=gpt-5.4-mini
RESEARCH_ON_GAPS=true

# Audio provider: use "local" for free macOS testing, or "elevenlabs" for production.
TTS_PROVIDER=elevenlabs

# Two distinct ElevenLabs voices are required when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_VOICE_A=replace_me
ELEVENLABS_VOICE_B=replace_me
ELEVENLABS_MODEL=eleven_multilingual_v2

# Built-in macOS voices used when TTS_PROVIDER=local. Check names with: say -v '?'
LOCAL_VOICE_A=Samantha
LOCAL_VOICE_B=Alex

# Cloudflare R2 S3-compatible upload configuration
R2_ACCOUNT_ID=replace_me
R2_BUCKET=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_PUBLIC_BASE_URL=https://media.example.com
